{
  "name": "symbiote-node",
  "version": "0.3.0-alpha.2",
  "type": "module",
  "description": "Visual Node Graph Editor + Execution Engine — extensible, themeable graph editor and runtime built on Symbiote.js",
  "main": "index.js",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "import": "./index.js",
      "default": "./index.js"
    },
    "./core": {
      "import": "./core/index.js",
      "default": "./core/index.js"
    },
    "./core/*": "./core/*",
    "./engine": {
      "import": "./engine/index.js",
      "default": "./engine/index.js"
    },
    "./graph": {
      "import": "./graph/index.js",
      "default": "./graph/index.js"
    },
    "./engine/cli": "./engine/cli.js",
    "./manifest": {
      "import": "./manifest/index.js",
      "default": "./manifest/index.js"
    },
    "./manifest/*": "./manifest/*",
    "./layout": {
      "import": "./layout/index.js",
      "default": "./layout/index.js"
    },
    "./tokens/*": "./tokens/*",
    "./rules/*": "./rules/*",
    "./schemas/*": "./schemas/*",
    "./custom-elements.json": "./custom-elements.json",
    "./display/output-preview": "./display/output-preview.js",
    "./display/highlight": "./display/highlight.js",
    "./display/markdown-formatter": "./display/markdown-formatter.js",
    "./themes/*": "./themes/*",
    "./shapes/*": "./shapes/*",
    "./plugins/*": "./plugins/*",
    "./package.json": "./package.json",
    "./ui": {
      "import": "./ui/index.js",
      "default": "./ui/index.js"
    }
  },
  "files": [
    "index.js",
    "custom-elements.json",
    "core/",
    "graph/",
    "engine/*.js",
    "manifest/",
    "tokens/",
    "rules/",
    "schemas/",
    "shapes/",
    "themes/",
    "plugins/",
    "canvas/",
    "node/",
    "interactions/",
    "layout/",
    "navigation/",
    "display/",
    "effects/",
    "chat/",
    "list/",
    "tree/",
    "toolbar/",
    "inspector/",
    "palette/",
    "menu/",
    "ui/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css.js",
    "**/*.tpl.js",
    "ui/index.js",
    "canvas/**/*.js",
    "node/**/*.js",
    "layout/**/*.js",
    "display/**/*.js",
    "effects/**/*.js",
    "chat/**/*.js",
    "list/**/*.js",
    "tree/**/*.js",
    "navigation/**/*.js",
    "toolbar/**/*.js",
    "inspector/**/*.js",
    "palette/**/*.js",
    "menu/**/*.js"
  ],
  "bin": {
    "symbiote-node": "./engine/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "demo": "npx -y serve -l 3000 .",
    "release:alpha": "npm version prerelease --preid=alpha && npm publish --tag alpha",
    "release:minor": "npm version minor && npm publish",
    "release:patch": "npm version patch && npm publish"
  },
  "keywords": [
    "node-editor",
    "graph-editor",
    "visual-programming",
    "node-graph",
    "symbiote",
    "web-components",
    "data-flow",
    "dag",
    "workflow-engine",
    "execution-engine"
  ],
  "peerDependencies": {
    "@symbiotejs/symbiote": ">=3.0.0",
    "ws": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RND-PRO/symbiote-node.git"
  },
  "author": "RND-PRO <nicothin@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
