{
  "name": "symbiote-node-workspace",
  "version": "0.3.0-alpha.5",
  "private": true,
  "type": "module",
  "description": "Workspace for Symbiote UI, engine, and terminal migration packages.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:packages": "npm test --workspaces --if-present",
    "pack:dry-run": "npm pack --dry-run --workspaces"
  },
  "overrides": {
    "@symbiotejs/symbiote": "3.8.0-webmcp.2"
  },
  "devDependencies": {
    "@symbiotejs/symbiote": "3.8.0-webmcp.2",
    "jsda-kit": "1.5.3",
    "linkedom": ">=0.16.0",
    "ws": ">=8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
